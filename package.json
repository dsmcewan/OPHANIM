{
  "name": "ophanim",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "bin": {
    "ophanim": "./ophanim/cli.mjs"
  },
  "scripts": {

  },
  {
   "id": "structured-output",
   "title": "Structured output",
   "what": "Constraining the answer to a schema."
  },
  {
   "id": "streaming",
   "title": "Streaming",
   "what": "Receiving the answer as it is produced."
  },
  {
   "id": "token-counting",
   "title": "Counting tokens",
   "what": "Asking how many tokens a request is before it is sent."
  },
  {
   "id": "batch",
   "title": "Batch",
   "what": "Sending many requests for later completion at a lower price."
  },
  {
   "id": "caching",
   "title": "Prompt caching",
   "what": "Reusing a prompt's prefix across requests."
  },
  {
   "id": "multi-agent",
   "title": "Agents and subagents",
   "what": "What the lab runs as an agent or lets a model delegate to."
  },
  {
   "id": "files",
   "title": "Files",
   "what": "Uploading files for a model to read."
  },
  {
   "id": "rate-limits",
   "title": "Rate limits",
   "what": "The limits on requests and tokens, and how they are reported."
  },
  {
   "id": "errors",
   "title": "Errors",
   "what": "Error codes and what each one means."
  },
  {
   "id": "deprecations",
   "title": "Deprecations",
   "what": "Which models and methods are ending, and when."
  },
  {
   "id": "changelog",
   "title": "Release notes",
   "what": "Where the lab announces what it released: the page to read when a model is new."
  },
  {
   "id": "models",
